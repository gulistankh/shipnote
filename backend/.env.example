# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- Database (local PostgreSQL, the "shipnote" database from pgAdmin) ----
# If your password has special characters like @ : / # %, write them URL-encoded.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/shipnote

# ---- Where the frontend runs (used for redirects after Stripe) ----
CLIENT_URL=http://localhost:5173

# ---- JWT_SECRET: a long random value, for example: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))" ----

# ---- Stripe (TEST keys only: sk_test_...) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=